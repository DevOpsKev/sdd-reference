{
    "name": "sdd-reference",
    "image": "git.kevinryan.io/kevin-ryan-associates-public/sdd-reference/devcontainer:latest",
    "remoteUser": "vscode",
    "features": {
      "ghcr.io/devcontainers/features/docker-in-docker:2": {}
    },
    "postCreateCommand": "pip install --user -r requirements-dev.txt && pnpm install",
    "remoteEnv": {
      "MISTRAL_API_KEY": "${localEnv:MISTRAL_API_KEY}",
      "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
      "OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY}"
    },
    "customizations": {
      "vscode": {
        "extensions": [
          "ms-python.python",
          "redhat.vscode-yaml",
          "ms-azuretools.vscode-docker"
        ]
      }
    }
  }
