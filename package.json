{
  "name": "sdd-reference",
  "version": "0.1.0",
  "private": true,
  "description": "Spec-Driven Development reference architecture — git hook tooling.",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "sdd": "sdd/scripts/execute.sh spec",
    "execute": "sdd/scripts/execute.sh",
    "prepare": "husky",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@tailwindcss/vite": "^4.2.4",
    "autoprefixer": "^10.5.0",
    "daisyui": "^5.5.19",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "yaml": "^2.8.4"
  },
  "lint-staged": {
    "*.py": [
      ".husky/lib/run-python.sh -m ruff check --fix --force-exclude",
      ".husky/lib/run-python.sh -m ruff format --force-exclude"
    ],
    "*.{yml,yaml}": ".husky/lib/check-yaml.sh",
    "*.toml": ".husky/lib/check-toml.sh",
    "*": ".husky/lib/run-python.sh .husky/lib/fix-whitespace.py"
  }
}
