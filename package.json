{
  "name": "sdd-reference",
  "version": "0.1.0",
  "private": true,
  "description": "Spec-Driven Development reference architecture — git hook tooling.",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "sdd": "sdd/scripts/execute.sh spec",
    "execute": "sdd/scripts/execute.sh",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "validate:tokens": "tsx build/validate-tokens.ts",
    "test:validator": "tsx build/run-validator-fixtures.ts",
    "test:unit": "node --import tsx --test 'build/lib/*.test.ts'",
    "lint": "eslint . && pnpm validate:tokens",
    "check": "pnpm typecheck && pnpm lint && pnpm test:unit",
    "dev": "vite",
    "prebuild": "tsx build/generate-index.ts",
    "build": "pnpm validate:tokens && vite build",
    "preview": "vite preview",
    "docker:build": "docker build -t sdd-reference:local .",
    "docker:serve": "docker run --rm -p 8080:8080 sdd-reference:local",
    "docker:up": "pnpm docker:build && pnpm docker:serve",
    "test": "pnpm test:unit && pnpm test:e2e",
    "pretest:e2e": "playwright install chromium",
    "test:e2e": "playwright test",
    "playwright:install": "playwright install chromium"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.50.1",
    "@types/node": "^25.6.0",
    "eslint": "^9.20.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vite": "^6.0.11",
    "yaml": "^2.8.4"
  },
  "pnpm": {
    "overrides": {
      "rollup": "npm:@rollup/wasm-node@4.60.3"
    }
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": "eslint --fix",
    "*.py": [
      ".husky/lib/run-python.sh -m ruff check --fix --force-exclude",
      ".husky/lib/run-python.sh -m ruff format --force-exclude"
    ],
    "*.{yml,yaml}": ".husky/lib/check-yaml.sh",
    "*.toml": ".husky/lib/check-toml.sh",
    "*": ".husky/lib/run-python.sh .husky/lib/fix-whitespace.py"
  }
}
